{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiny-context.dev/schemas/design-authority-delta-assessment-v1.schema.json",
  "title": "Design Authority Delta Assessment V1",
  "oneOf": [
    { "$ref": "#/$defs/consistent" },
    { "$ref": "#/$defs/taskOnly" },
    { "$ref": "#/$defs/crossTask" },
    { "$ref": "#/$defs/candidate" }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_version", "entry_path", "manifest_path", "closure_digest", "revision"],
      "properties": {
        "format_version": { "const": 1 },
        "entry_path": { "const": "DESIGN.md" },
        "manifest_path": {
          "oneOf": [
            { "type": "null" },
            { "const": "design_system/authority.manifest.json" }
          ]
        },
        "closure_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "revision": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        }
      }
    },
    "base": {
      "type": "object",
      "required": ["schema_version", "assessment", "based_on"],
      "properties": {
        "schema_version": { "const": "design-authority-delta-assessment-v1" },
        "assessment": {
          "enum": [
            "consistent_with_current_authority",
            "task_local_variance",
            "authority_delta_candidate"
          ]
        },
        "based_on": { "$ref": "#/$defs/identity" }
      }
    },
    "stringSet": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "sourceRefSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\\\#]+(?:#[^#]+)?$"
      },
      "uniqueItems": true
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "proposal", "rationale"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "proposal": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "components", "patterns", "motion", "platforms"],
      "properties": {
        "tokens": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "components": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "patterns": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "motion": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "platforms": { "type": "array", "items": { "$ref": "#/$defs/change" } }
      }
    },
    "consistent": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "assessment", "based_on", "evidence", "observed_variances"],
          "properties": {
            "schema_version": { "const": "design-authority-delta-assessment-v1" },
            "assessment": { "const": "consistent_with_current_authority" },
            "based_on": { "$ref": "#/$defs/identity" },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tokens", "components", "rules"],
              "properties": {
                "tokens": { "$ref": "#/$defs/stringSet" },
                "components": { "$ref": "#/$defs/stringSet" },
                "rules": { "$ref": "#/$defs/sourceRefSet" }
              }
            },
            "observed_variances": { "type": "array", "maxItems": 0 }
          }
        }
      ]
    },
    "varianceBase": {
      "type": "object",
      "required": ["schema_version", "assessment", "based_on", "scope", "reason", "affected_rules", "durability"],
      "properties": {
        "schema_version": { "const": "design-authority-delta-assessment-v1" },
        "assessment": { "const": "task_local_variance" },
        "based_on": { "$ref": "#/$defs/identity" },
        "scope": { "allOf": [{ "$ref": "#/$defs/stringSet" }, { "minItems": 1 }] },
        "reason": { "type": "string", "minLength": 1 },
        "affected_rules": { "allOf": [{ "$ref": "#/$defs/sourceRefSet" }, { "minItems": 1 }] },
        "durability": { "enum": ["task_only", "cross_task_candidate"] }
      }
    },
    "taskOnly": {
      "allOf": [
        { "$ref": "#/$defs/varianceBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "assessment", "based_on", "scope", "reason", "affected_rules", "durability", "precedent"],
          "properties": {
            "schema_version": { "const": "design-authority-delta-assessment-v1" },
            "assessment": { "const": "task_local_variance" },
            "based_on": { "$ref": "#/$defs/identity" },
            "scope": { "$ref": "#/$defs/stringSet" },
            "reason": { "type": "string", "minLength": 1 },
            "affected_rules": { "$ref": "#/$defs/sourceRefSet" },
            "durability": { "const": "task_only" },
            "precedent": { "const": "forbidden" }
          }
        }
      ]
    },
    "crossTask": {
      "allOf": [
        { "$ref": "#/$defs/varianceBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "assessment", "based_on", "scope", "reason", "affected_rules", "durability", "required_owner"],
          "properties": {
            "schema_version": { "const": "design-authority-delta-assessment-v1" },
            "assessment": { "const": "task_local_variance" },
            "based_on": { "$ref": "#/$defs/identity" },
            "scope": { "$ref": "#/$defs/stringSet" },
            "reason": { "type": "string", "minLength": 1 },
            "affected_rules": { "$ref": "#/$defs/sourceRefSet" },
            "durability": { "const": "cross_task_candidate" },
            "required_owner": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "path"],
              "properties": {
                "type": { "const": "screen_contract" },
                "path": { "type": "string", "pattern": "^project_context/.+\\.md$" }
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "assessment", "based_on", "proposed_changes", "supporting_resources", "representative_scenarios"],
          "properties": {
            "schema_version": { "const": "design-authority-delta-assessment-v1" },
            "assessment": { "const": "authority_delta_candidate" },
            "based_on": { "$ref": "#/$defs/identity" },
            "proposed_changes": { "$ref": "#/$defs/changes" },
            "supporting_resources": { "$ref": "#/$defs/sourceRefSet" },
            "representative_scenarios": { "allOf": [{ "$ref": "#/$defs/stringSet" }, { "minItems": 1 }] }
          }
        }
      ]
    }
  }
}
