{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Seven128/project-tiny-context-harness/schemas/long-task-external-confirmation-record-v1.schema.json",
  "title": "Tiny Context Long-Task External Confirmation Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "confirmation_ref",
    "compiled_identity",
    "authority_revision",
    "candidate",
    "actor",
    "session",
    "results",
    "artifact_hashes",
    "relevant_input_identity",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "long-task-external-confirmation-record-v1"
    },
    "confirmation_ref": {
      "$ref": "#/$defs/key"
    },
    "compiled_identity": {
      "$ref": "#/$defs/sha256"
    },
    "authority_revision": {
      "type": "integer",
      "minimum": 0
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_head", "git_tree", "snapshot_sha256"],
      "properties": {
        "git_head": { "$ref": "#/$defs/gitObject" },
        "git_tree": { "$ref": "#/$defs/gitObject" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "authority_kind"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "role": { "$ref": "#/$defs/nonempty" },
        "authority_kind": {
          "enum": ["human", "expert", "external_system"]
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_ref",
        "environment_identity",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "target_ref": { "$ref": "#/$defs/semanticRef" },
        "environment_identity": { "$ref": "#/$defs/nonempty" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    },
    "artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "relevant_input_identity": {
      "type": "string",
      "pattern": "^(?:bounded|whole):[a-f0-9]{64}$"
    },
    "record_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "semanticRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_ref",
        "fact_ref",
        "claim_ref",
        "applicability_ref",
        "verdict",
        "evidence_refs"
      ],
      "properties": {
        "obligation_ref": { "$ref": "#/$defs/semanticRef" },
        "fact_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/semanticRef" }
          ]
        },
        "claim_ref": { "$ref": "#/$defs/semanticRef" },
        "applicability_ref": { "$ref": "#/$defs/semanticRef" },
        "actual": true,
        "verdict": { "enum": ["passed", "failed", "unable"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        },
        "rationale": { "type": "string" }
      }
    }
  }
}
