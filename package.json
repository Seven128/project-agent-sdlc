{
  "name": "project-tiny-context-harness",
  "private": true,
  "version": "0.1.0",
  "description": "Reference workspace for Project Tiny Context Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seven128/project-tiny-context-harness.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace project-tiny-context-harness",
    "test": "npm test --workspace project-tiny-context-harness",
    "test:affected": "npm test",
    "format": "prettier --write \"packages/ty-context/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/ty-context/src/**/*.ts\"",
    "ty-context": "node packages/ty-context/dist/cli.js",
    "release:prepare": "npm run build && node tools/prepare_release.mjs"
  },
  "tyContext": {
    "harnessFolderName": ".codex"
  },
  "devDependencies": {
    "prettier": "^3.9.5"
  }
}
