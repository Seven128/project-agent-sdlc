{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track", "case_results"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "dra-fresh-agent-result-v1"
    },
    "track": { "type": "string", "const": "dra-semantic-recovery" },
    "case_results": {
      "type": "array",
      "minItems": 49,
      "maxItems": 49,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "disposition",
          "accepted_keys",
          "rejected_keys",
          "unresolved_keys",
          "authority_rows",
          "checkpoint",
          "write_action",
          "audit_status",
          "audit_types",
          "reason_codes",
          "derived_live_state",
          "handoff_ready",
          "next_action"
        ],
        "properties": {
          "id": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": ["allow", "block", "unavailable", "idempotent"]
          },
          "accepted_keys": { "type": "array", "items": { "type": "string" } },
          "rejected_keys": { "type": "array", "items": { "type": "string" } },
          "unresolved_keys": { "type": "array", "items": { "type": "string" } },
          "authority_rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "origin", "decision_authority", "status"],
              "properties": {
                "key": { "type": "string" },
                "origin": {
                  "type": "string",
                  "enum": [
                    "user-direct",
                    "necessary-derived",
                    "repository-evidence-backed",
                    "provider-suggested"
                  ]
                },
                "decision_authority": { "type": "string" },
                "status": {
                  "type": "string",
                  "enum": ["accepted", "rejected", "unresolved"]
                }
              }
            }
          },
          "checkpoint": {
            "type": "string",
            "enum": ["none", "create", "retain", "reject"]
          },
          "write_action": {
            "type": "string",
            "enum": ["none", "preview", "apply", "idempotent-no-write", "block"]
          },
          "audit_status": {
            "type": "string",
            "enum": ["not-applicable", "balanced", "blocked"]
          },
          "audit_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "requirements-to-resource",
                "resource-to-requirements",
                "unexpected-blast-radius"
              ]
            }
          },
          "reason_codes": { "type": "array", "items": { "type": "string" } },
          "derived_live_state": { "type": "boolean" },
          "handoff_ready": { "type": "boolean" },
          "next_action": { "type": "string" }
        }
      }
    }
  }
}
