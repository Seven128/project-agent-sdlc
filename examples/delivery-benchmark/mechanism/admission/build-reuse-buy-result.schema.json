{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track", "case_results"],
  "properties": {
    "schema_version": { "type": "string", "const": "build-reuse-buy-fresh-agent-result-v1" },
    "track": { "type": "string", "const": "build-reuse-buy" },
    "case_results": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "allowed_solution_set", "prohibited_failure_modes", "selected_solution", "rationale_codes"],
        "properties": {
          "id": { "type": "string" },
          "decision": { "type": "string", "enum": ["allow", "block", "decision-required"] },
          "allowed_solution_set": {
            "type": "array",
            "items": { "type": "string", "enum": ["reuse-owner", "standard-library", "installed-dependency", "mature-external-library", "bounded-self-implementation", "intentional-non-abstraction"] },
            "minItems": 1
          },
          "prohibited_failure_modes": { "type": "array", "items": { "type": "string" } },
          "selected_solution": { "type": "string", "enum": ["reuse-owner", "standard-library", "installed-dependency", "mature-external-library", "bounded-self-implementation", "intentional-non-abstraction", "none"] },
          "rationale_codes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
